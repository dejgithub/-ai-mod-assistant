# Reddit API Credentials
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=AI-Mod-Assistant/v1.0

# AI API Key (OpenAI or Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Database
DATABASE_URL=sqlite:///./moderator.db

# App Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# Devvit Backend URL (the public URL where your backend is deployed)
# The Devvit app will call this for AI analysis
BACKEND_PUBLIC_URL=https://your-backend.onrender.com
